# ============================================================
# App Store 评论分析工具 - 环境变量模板
# 使用前请复制本文件为 .env 并填入真实值
# 命令: cp .env.example .env
# 注意: .env 文件已加入 .gitignore，切勿提交到仓库
# ============================================================

# ---------- LLM API 配置 ----------
# config.py 支持多种命名习惯（按优先级读取），任选其一填写即可：
#   - API Key:  LLM_API_KEY / DEEPSEEK_API_KEY / OPENAI_API_KEY
#   - Base URL: LLM_BASE_URL / BASE_URL / DEEPSEEK_BASE_URL / OPENAI_BASE_URL
#   - Model:    LLM_MODEL / MODEL / DEEPSEEK_MODEL / OPENAI_MODEL

# LLM API Key（必填）
# DeepSeek 申请地址: https://platform.deepseek.com/
# 也可使用任何兼容 OpenAI 格式的服务（如 OpenAI、智谱、Moonshot 等）
LLM_API_KEY=sk-your-deepseek-api-key-here
# DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
# OPENAI_API_KEY=sk-your-openai-api-key-here

# LLM Base URL（兼容 OpenAI SDK 调用）
# DeepSeek 官方: https://api.deepseek.com
# OpenAI 官方: https://api.openai.com/v1
LLM_BASE_URL=https://api.deepseek.com
# BASE_URL=https://api.deepseek.com
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# OPENAI_BASE_URL=https://api.openai.com/v1

# 使用的模型名称
# DeepSeek: deepseek-chat (通用对话) / deepseek-reasoner (推理增强)
# OpenAI: gpt-4o-mini / gpt-4o
LLM_MODEL=deepseek-chat
# MODEL=deepseek-chat
# DEEPSEEK_MODEL=deepseek-chat
# OPENAI_MODEL=gpt-4o-mini

# ---------- LLM 调用参数 ----------

# 生成温度（0=确定, 1=随机），分析任务建议 0.3
LLM_TEMPERATURE=0.3

# 最大输出 token 数
LLM_MAX_TOKENS=4096

# API 调用超时（秒）
LLM_TIMEOUT=60

# 最大重试次数（指数退避）
LLM_MAX_RETRIES=3

# ---------- 数据抓取参数 ----------

# 单次抓取的最大页数（每页最多 50 条评论，page=1 仅返回应用信息）
MAX_REVIEW_PAGES=10

# 请求间隔（秒），遵守速率限制
REQUEST_INTERVAL=1.5

# HTTP 请求超时（秒）
HTTP_TIMEOUT=15

# ---------- 默认区域 ----------

# App Store 区域代码（us=美国区）
DEFAULT_COUNTRY=us
